generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LEAD
  MEMBER
  FINANCE
}
enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}
enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}
enum ServiceType {
  BUSINESS_MENTORING
  SYSTEM_DIGITALIZATION
  COMBINED
}
enum ProgramStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum ProgramRisk {
  HEALTHY
  ATTENTION
  CRITICAL
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum MeetingStatus {
  DRAFT
  FINAL
}
enum DocumentCategory {
  ADMINISTRATION
  ASSESSMENT
  MATERIAL
  DELIVERABLE
  OTHER
  PAYMENT_PROOF
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}
enum PaymentMethod {
  TRANSFER
  CASH
  OTHER
}
enum PaymentStatus {
  VALID
  VOID
}
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ExpenseCategory {
  GAJI
  SEWA
  TOOLS_SOFTWARE
  TRANSPORT
  OPERASIONAL
  MARKETING
  LAINNYA
}

model OrganizationSettings {
  id              String   @id @default("organization")
  name            String
  legalName       String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  jobTitle              String?
  email                 String          @unique
  passwordHash          String
  role                  UserRole
  status                RecordStatus    @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  leadClients           Client[]        @relation("ClientLead")
  programMembers        ProgramMember[]
  assignedTasks         Task[]          @relation("TaskAssignee")
  taskComments          TaskComment[]
  meetingsCreated       MeetingNote[]   @relation("MeetingCreator")
  documentsUploaded     Document[]      @relation("DocumentUploader")
  invoicesCreated       Invoice[]       @relation("InvoiceCreator")
  paymentsRecorded      Payment[]       @relation("PaymentRecorder")
  auditLogs             AuditLog[]       @relation("AuditActor")
  sessions              Session[]
  authTokens            AuthToken[]
  mutationRequests      MutationRequest[]
  programTemplates      ProgramTemplate[] @relation("ProgramTemplateCreator")
  recurringTaskRules    RecurringTaskRule[] @relation("RecurringTaskAssignee")
  reviewedDocuments     Document[]        @relation("DocumentReviewer")
  approvedInvoices      Invoice[]         @relation("InvoiceApprover")
  expenses              Expense[]         @relation("ExpenseCreator")
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model AuthToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  type       String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}

model MutationRequest {
  id         String   @id @default(cuid())
  key        String   @unique
  userId     String
  operation  String
  response   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, operation, createdAt])
}

model InvoiceSequence {
  year        Int      @id
  nextNumber  Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model Client {
  id          String        @id @default(cuid())
  businessName String
  sector      String?
  address     String?
  notes       String?
  status      ClientStatus  @default(PROSPECT)
  leadId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lead        User?         @relation("ClientLead", fields: [leadId], references: [id])
  contacts    ClientContact[]
  programs    Program[]
  invoices    Invoice[]
  documents   Document[]
  meetings    MeetingNote[]
  @@index([status])
  @@index([leadId])
}

model ClientContact {
  id         String   @id @default(cuid())
  clientId   String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@index([clientId])
}

model Program {
  id           String          @id @default(cuid())
  clientId     String
  name         String
  serviceType  ServiceType
  objective    String
  deliverables String?
  startDate   DateTime
  targetDate  DateTime
  completedAt DateTime?
  status      ProgramStatus   @default(PLANNED)
  healthScore Int?
  risk        ProgramRisk     @default(HEALTHY)
  riskNote    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  members     ProgramMember[]
  tasks       Task[]
  meetings    MeetingNote[]
  documents   Document[]
  invoices    Invoice[]
  recurringTaskRules RecurringTaskRule[]
  @@index([clientId, status])
  @@index([targetDate])
}

model ProgramMember {
  id        String   @id @default(cuid())
  programId String
  userId    String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  program   Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([programId, userId])
  @@index([userId])
}

model Task {
  id             String          @id @default(cuid())
  programId      String
  assigneeId     String
  title          String
  description    String?
  status         TaskStatus      @default(TODO)
  priority       TaskPriority    @default(MEDIUM)
  dueDate        DateTime
  blockedReason  String?
  completionNote String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  program        Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  assignee       User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  checklist      TaskChecklistItem[]
  comments       TaskComment[]
  meetingActions MeetingActionItem[]
  @@index([programId, status])
  @@index([assigneeId, dueDate])
  @@index([dueDate])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  sortOrder Int      @default(0)
  isDone    Boolean  @default(false)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, sortOrder])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([taskId, createdAt])
}

model MeetingNote {
  id          String        @id @default(cuid())
  clientId    String
  programId   String
  creatorId   String
  title       String
  meetingAt   DateTime
  participants String?
  summary     String?
  summaryJson Json?
  summaryText String?
  decisions   String?
  decisionsJson Json?
  decisionsText String?
  status      MeetingStatus @default(DRAFT)
  correctionReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  program     Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  creator     User          @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  actionItems MeetingActionItem[]
  @@index([programId, meetingAt])
  @@index([clientId, meetingAt])
}

model MeetingActionItem {
  id           String       @id @default(cuid())
  meetingId    String
  description  String
  taskId       String?
  noTaskReason String?
  meeting      MeetingNote  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@index([meetingId])
}

model Document {
  id           String           @id @default(cuid())
  clientId     String
  programId    String
  uploadedById String
  displayName  String
  storageKey   String           @unique
  mimeType     String
  sizeBytes    Int
  category     DocumentCategory @default(OTHER)
  isArchived   Boolean          @default(false)
  version      Int              @default(1)
  reviewStatus ReviewStatus     @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime         @default(now())
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  program      Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  uploadedBy   User             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy   User?            @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([programId, isArchived])
  @@index([clientId])
}

model Invoice {
  id                 String        @id @default(cuid())
  clientId           String
  programId          String
  createdById         String
  invoiceNumber      String?       @unique
  issueDate           DateTime
  dueDate             DateTime
  status              InvoiceStatus @default(DRAFT)
  clientNameSnapshot  String
  clientAddressSnapshot String?
  organizationNameSnapshot String
  bankSnapshot        String?
  notes               String?
  totalAmount         Int           @default(0)
  replacementForId    String?
  issuedAt            DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  approvalStatus      ApprovalStatus @default(PENDING)
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  program             Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy           User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy          User?         @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  payments            Payment[]
  replacementFor      Invoice?      @relation("InvoiceReplacement", fields: [replacementForId], references: [id], onDelete: Restrict)
  replacement         Invoice[]     @relation("InvoiceReplacement")
  @@index([clientId, status])
  @@index([programId])
  @@index([dueDate, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Int
  amount      Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  recordedById String
  paidAt       DateTime
  amount       Int
  method       PaymentMethod
  reference    String?
  proofDocumentId String?
  status       PaymentStatus @default(VALID)
  voidReason   String?
  createdAt    DateTime      @default(now())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([invoiceId, status])
  @@index([paidAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  objectType String
  objectId   String
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([objectType, objectId, createdAt])
  @@index([actorId, createdAt])
}

model ProgramTemplate {
  id           String      @id @default(cuid())
  name         String
  serviceType  ServiceType
  objective    String
  deliverables String?
  defaultTasks Json
  createdById  String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    User        @relation("ProgramTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([isActive, createdAt])
}

model RecurringTaskRule {
  id          String       @id @default(cuid())
  programId   String
  assigneeId  String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  frequency   String
  nextDueDate DateTime
  endDate     DateTime?
  isActive    Boolean      @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  assignee    User         @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  @@index([isActive, nextDueDate])
  @@index([programId])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Int
  expenseDate DateTime
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([category, expenseDate])
  @@index([createdById])
}
