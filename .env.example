DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shaff_development?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Shaff Development"
# Isi hanya saat menjalankan seed di development; jangan pakai password bersama.
SEED_DEMO_PASSWORD="replace-with-a-unique-12-character-password"
# Gunakan volume privat EasyPanel untuk file client.
FILE_STORAGE_PATH="/app/data/private"
# Hanya true saat bootstrap schema database kosong, lalu kembalikan false.
PRISMA_DB_PUSH="false"
PRISMA_MIGRATE_DEPLOY="false"
